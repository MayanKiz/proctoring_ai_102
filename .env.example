# Copy this file to `.env` and fill in your own values:   cp .env.example .env
# NEVER commit the real .env file (it is already listed in .gitignore).

# --- Telegram (required for alerts) ---
# 1) Open Telegram, talk to @BotFather, send /newbot and copy the token it gives you.
# 2) Send any message to your new bot, then open
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the number at  "chat":{"id": ... }
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Optional tuning (defaults shown) ---
# ALERT_COOLDOWN_SECONDS=5
# LOOK_AWAY_SECONDS=2
# CAMERA_INDEX=0
# SHOW_WINDOW=true
# FACE_BACKEND=auto          # auto | legacy | tasks | haar
# FLIP_FRAME=false           # true only if your camera image is mirrored
# MIRROR_DIRECTIONS=false    # true if LEFT/RIGHT labels feel reversed
# YAW_THRESHOLD_DEG=25
# PITCH_THRESHOLD_DEG=18
# ALERT_ON_SUSPICIOUS_MOVEMENT=false
